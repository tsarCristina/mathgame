        <div class="mt-5 space-y-3.5">
          <input id="inp-name" class="name-input w-full rounded-2xl px-5 py-3.5 font-bold text-lg" type="text" maxlength="30" placeholder="–ò–º—è" autocomplete="off">
          <input id="inp-surname" class="name-input w-full rounded-2xl px-5 py-3.5 font-bold text-lg" type="text" maxlength="30" placeholder="–§–∞–º–∏–ª–∏—è" autocomplete="off">
