<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
<link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,400;0,600;0,700;0,800;0,900;1,700&amp;family=Caveat:wght@600;700&amp;display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#FAF6EF; --ink:#332E29; --muted:#7D766C; --faint:#B9B0A2;
    --accent:#CE7048; --accent-dark:#B55A36; --accent-soft:#F7E3D7;
    --sage:#6F9B77; --sage-dark:#58805F; --sage-soft:#E7F0E7;
    --red:#D65A4E; --red-soft:#FBE9E5; --card:#FFFFFF; --line:#EAE2D4;
  }
  html{ -webkit-tap-highlight-color: transparent; }
  body{ font-family:'Nunito',ui-sans-serif,system-ui,sans-serif; background:var(--paper); color:var(--ink); }
  .font-hand{ font-family:'Caveat',cursive; }

  /* —Ñ–æ–Ω–æ–≤—ã–µ –º—è–≥–∫–∏–µ –ø—è—Ç–Ω–∞ */
  .blob{ position:fixed; border-radius:9999px; filter:blur(70px); opacity:.5; pointer-events:none; z-index:0; }

  .screen{ animation:fadeUp .55s cubic-bezier(.22,1,.36,1) both; }
  @keyframes fadeUp{ from{opacity:0; transform:translateY(18px);} to{opacity:1; transform:none;} }

  .card-pop{ animation:cardPop .5s cubic-bezier(.34,1.4,.4,1) both; }
  @keyframes cardPop{ from{opacity:0; transform:scale(.96) translateY(10px);} to{opacity:1; transform:none;} }

  .btn-primary{ background:var(--accent); color:#fff; transition:.22s cubic-bezier(.34,1.4,.4,1); box-shadow:0 6px 16px -6px rgba(206,112,72,.55), inset 0 -3px 0 rgba(0,0,0,.12); }
  .btn-primary:hover:not(:disabled){ background:var(--accent-dark); transform:translateY(-2px); box-shadow:0 10px 20px -8px rgba(206,112,72,.6), inset 0 -3px 0 rgba(0,0,0,.12); }
  .btn-primary:active:not(:disabled){ transform:translateY(1px) scale(.98); }
  .btn-primary:disabled{ background:#D8D0C2; box-shadow:none; cursor:not-allowed; color:#fff; }

  .btn-ghost{ background:transparent; color:var(--muted); border:2px solid var(--line); transition:.2s; }
  .btn-ghost:hover:not(:disabled){ border-color:var(--accent); color:var(--accent); }
  .btn-ghost:disabled{ opacity:.4; cursor:not-allowed; }

  .ans-input{ background:var(--paper); border:3px solid var(--line); transition:.2s; }
  .ans-input:focus{ outline:none; border-color:var(--accent); background:#fff; box-shadow:0 0 0 5px rgba(206,112,72,.14); }
  .ans-input.filled{ border-color:var(--accent); background:#fff; }

  .sign-btn{ width:2em; height:2em; font-size:.4em; line-height:1; flex:none;
    display:flex; align-items:center; justify-content:center;
    background:var(--accent-soft); color:#8A5A3C; border:3px solid #EED7C3; border-radius:.7em;
    touch-action:manipulation; user-select:none; -webkit-user-select:none;
    transition:transform .2s cubic-bezier(.34,1.5,.4,1), background .2s, color .2s, border-color .2s; }
  .sign-btn:hover{ transform:translateY(-2px); background:#F4DAC6; }
  .sign-btn:active{ transform:scale(.88); }
  .sign-btn.minus{ background:var(--accent); color:#fff; border-color:var(--accent); }

  .name-input{ background:#fff; border:2.5px solid var(--line); transition:.2s; }
  .name-input:focus{ outline:none; border-color:var(--accent); box-shadow:0 0 0 5px rgba(206,112,72,.13); }

  /* —Å—Ç–µ–ø-–ø–∏–ª—é–ª–∏ */
  .step-pill{ transition:.3s; }
  .step-pill.active{ background:var(--accent); color:#fff; border-color:var(--accent); }
  .step-pill.done{ background:var(--sage-soft); color:var(--sage-dark); border-color:#CBDfCB; }

  /* —á–∏—Å–ª–æ–≤–∞—è –ø—Ä—è–º–∞—è */
  #line-wrap{ touch-action:none; }
  #line-wrap.locked{ cursor:not-allowed; }
  #line-wrap.unlocked{ cursor:crosshair; }

  .hint-wiggle{ animation:wiggle .45s ease; }
  @keyframes wiggle{ 0%,100%{transform:translateX(0)} 25%{transform:translateX(-5px)} 50%{transform:translateX(5px)} 75%{transform:translateX(-3px)} }

  /* –∫–æ—Ç–∏–∫ */
  .kitten-bob{ animation:bob 3.2s ease-in-out infinite; transform-origin:50% 100%; }
  @keyframes bob{ 0%,100%{transform:translateY(0)} 50%{transform:translateY(-7px)} }
  .paw-wave{ animation:wave 1.3s ease-in-out infinite; transform-box:fill-box; transform-origin:20% 90%; }
  @keyframes wave{ 0%,100%{transform:rotate(0deg)} 40%{transform:rotate(-24deg)} 70%{transform:rotate(-12deg)} }
  .blink-eyes{ animation:blink 4.6s infinite; transform-box:fill-box; transform-origin:center; }
  @keyframes blink{ 0%,93%,100%{transform:scaleY(1)} 96%{transform:scaleY(.15)} }

  #kitten-pop{ transition:transform .55s cubic-bezier(.3,1.5,.4,1), opacity .4s ease; }
  #kitten-pop.hiddenpop{ transform:translateY(40px) scale(.7); opacity:0; pointer-events:none; }
  .bubble-tail{ position:absolute; bottom:-9px; right:44px; width:0; height:0; border-left:10px solid transparent; border-right:10px solid transparent; border-top:11px solid #fff; }

  /* –∫–æ–Ω—Ñ–µ—Ç—Ç–∏ */
  .burst-dot{ position:fixed; width:9px; height:9px; border-radius:99px; z-index:80; pointer-events:none; animation:burst .85s cubic-bezier(.2,.8,.4,1) forwards; }
  @keyframes burst{ 0%{transform:translate(0,0) scale(1); opacity:1;} 100%{transform:translate(var(--dx),var(--dy)) scale(.3); opacity:0;} }

  .score-pulse{ animation:pulse .5s cubic-bezier(.34,1.5,.4,1); }
  @keyframes pulse{ 0%{transform:scale(1)} 40%{transform:scale(1.28)} 100%{transform:scale(1)} }

  tr.rowline{ border-bottom:1.5px solid var(--line); }
  tr.rowline:last-child{ border-bottom:none; }

  ::selection{ background:var(--accent-soft); }
</style>
</head>
<body class="min-h-screen overflow-x-hidden">

<!-- —Ñ–æ–Ω–æ–≤—ã–µ –ø—è—Ç–Ω–∞ -->
<div class="blob w-[420px] h-[420px] -top-24 -left-24" style="background:#F3D9C6"></div>
