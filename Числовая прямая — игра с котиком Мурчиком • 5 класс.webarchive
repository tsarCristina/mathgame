      <!-- –∫–æ—Ç–∏–∫ –∏ –ø—Ä–∞–≤–∏–ª–∞ -->
      <div class="card-pop bg-[#FFFDF9] rounded-[28px] border border-[#EAE2D4] shadow-[0_18px_40px_-24px_rgba(51,46,41,.2)] p-6 sm:p-8 flex flex-col items-center" style="animation-delay:.1s">
