<script>
/* ============================================================
   –î–ê–ù–ù–´–ï: 30 –∑–∞–¥–∞–Ω–∏–π  [a, –æ–ø–µ—Ä–∞—Ü–∏—è, b]  ‚Üí  a ¬± b
   –í—Å–µ —á–∏—Å–ª–∞ –∏ —Ä–µ–∑—É–ª—å—Ç–∞—Ç—ã –≤ –ø—Ä–µ–¥–µ–ª–∞—Ö ‚àí10 ‚Ä¶ 30
============================================================ */
const TASKS = [
  [ 3,'+', 4],[ 9,'-', 5],[ 6,'+', 7],[15,'-', 6],[ 8,'-',10],
  [ 2,'+',11],[-3,'+', 5],[12,'-', 8],[-4,'+', 6],[ 7,'-',12],
  [-2,'+', 8],[18,'-', 9],[-5,'+', 9],[11,'-',15],[14,'+', 6],
  [-6,'+',10],[20,'-', 7],[-8,'+',12],[ 5,'-', 9],[16,'+', 8],
  [-7,'+',10],[22,'-', 9],[25,'+', 5],[-9,'+', 8],[-6,'+',14],
  [21,'-',12],[-1,'-', 6],[13,'+', 9],[17,'-',20],[-10,'+',17]
];

const PHRASES = [
  '–û—Ç–ª–∏—á–Ω–æ —Å–ø—Ä–∞–≤–ª—è–µ—à—å—Å—è! –ü—Ä–æ–¥–æ–ª–∂–∞–π –≤ —Ç–æ–º –∂–µ –¥—É—Ö–µ!',
  '–ü–æ–º–Ω–∏: –ø—Ä–∏–±–∞–≤–ª—è–µ–º ‚Äî –∏–¥—ë–º –≤–ø—Ä–∞–≤–æ, –≤—ã—á–∏—Ç–∞–µ–º ‚Äî –≤–ª–µ–≤–æ!',
  '–ú—É—Ä-–º—É—Ä! –£ —Ç–µ–±—è –∑–¥–æ—Ä–æ–≤–æ –ø–æ–ª—É—á–∞–µ—Ç—Å—è!',
  '–ù–µ –±–æ–π—Å—è –º–∏–Ω—É—Å–æ–≤ ‚Äî –æ—Ç—Ä–∏—Ü–∞—Ç–µ–ª—å–Ω—ã–µ —á–∏—Å–ª–∞ —Å–æ–≤—Å–µ–º –Ω–µ —Å—Ç—Ä–∞—à–Ω—ã–µ!',
  '–°—á–∏—Ç–∞–π –¥–µ–ª–µ–Ω–∏—è –≤–Ω–∏–º–∞—Ç–µ–ª—å–Ω–æ, –Ω–µ —Å–ø–µ—à–∏!',
  '–ö–∞–∂–¥—ã–π –ø—Ä–∏–º–µ—Ä –¥–µ–ª–∞–µ—Ç —Ç–µ–±—è —Å–∏–ª—å–Ω–µ–µ –≤ –º–∞—Ç–µ–º–∞—Ç–∏–∫–µ!',
  '–í–Ω–∏–º–∞—Ç–µ–ª—å–Ω–æ —Å–º–æ—Ç—Ä–∏ –Ω–∞ –∑–Ω–∞–∫: –ø–ª—é—Å –∏–ª–∏ –º–∏–Ω—É—Å?',
  '–¢—ã —É–º–Ω–∏—Ü–∞! –Ø –≥–æ—Ä–∂—É—Å—å —Ç–æ–±–æ–π!',
  '–ï—Å–ª–∏ –æ—à–∏–±—Å—è ‚Äî –Ω–µ –±–µ–¥–∞! –ì–ª–∞–≤–Ω–æ–µ –ø–æ–Ω—è—Ç—å, –∫–∞–∫ –ø—Ä–∞–≤–∏–ª—å–Ω–æ.',
  '–î—ã—à–∏ —Å–ø–æ–∫–æ–π–Ω–æ –∏ —Å—á–∏—Ç–∞–π ‚Äî —É —Ç–µ–±—è –≤—Å—ë –ø–æ–ª—É—á–∏—Ç—Å—è!',
  '–ß–∏—Å–ª–æ–≤–∞—è –ø—Ä—è–º–∞—è ‚Äî —Ç–≤–æ–π –ª—É—á—à–∏–π –ø–æ–º–æ—â–Ω–∏–∫!',
  '–ö–æ—Ç–∏–∫–∏ –≤–µ—Ä—è—Ç –≤ —Ç–µ–±—è! –ú—É—Ä!',
  '–£—Ö —Ç—ã, –∫–∞–∫ –∑–¥–æ—Ä–æ–≤–æ! –¢–∞–∫ –¥–µ—Ä–∂–∞—Ç—å!',
  '–ï—â—ë —á—É—Ç—å-—á—É—Ç—å ‚Äî –∏ —Ç—ã —Å—Ç–∞–Ω–µ—à—å —á–µ–º–ø–∏–æ–Ω–æ–º –ø—Ä—è–º–æ–π!'
];

/* ============================================================
   –°–û–°–¢–û–Ø–ù–ò–ï
============================================================ */
const S = {
  name:'', surname:'', idx:0, score:0,
  stats:[],            // {a,op,b,res,userAns,ansOk,lineOk,ok}
  startVal:null, endVal:null,
  dragging:false, checked:false, okNow:false
};
const res  = t => t[0] + (t[1]==='+' ? t[2] : -t[2]);
const fmt  = n => (n<0 ? '‚àí'+Math.abs(n) : ''+n);
const fmtD = n => (n>0 ? '+'+n : n<0 ? '‚àí'+Math.abs(n) : '0');
const $ = id => document.getElementById(id);
const cur = () => TASKS[S.idx];

function icons(){ if(window.lucide) lucide.createIcons(); }

/* ============================================================
   –ö–û–¢–ò–ö (SVG)
============================================================ */
function kittenSVG(){
  return `
  <svg viewBox="0 0 200 190" class="w-full h-auto overflow-visible">
    <!-- —Ö–≤–æ—Å—Ç -->
    <path d="M150 150 q34 4 30 -30 q-2 -18 -18 -16" fill="none" stroke="#EFB287" stroke-width="13" stroke-linecap="round"/>
    <!-- —Ç–µ–ª–æ -->
    <ellipse cx="100" cy="140" rx="60" ry="44" fill="#EFB287"/>
    <ellipse cx="100" cy="150" rx="38" ry="28" fill="#F7D3AE"/>
    <!-- —É—à–∏ -->
    <path d="M62 60 L80 14 L104 48 Z" fill="#EFB287"/>
    <path d="M138 60 L120 14 L96 48 Z" fill="#EFB287"/>
    <path d="M70 54 L81 28 L95 48 Z" fill="#F6C39C"/>
    <path d="M130 54 L119 28 L105 48 Z" fill="#F6C39C"/>
    <!-- –≥–æ–ª–æ–≤–∞ -->
    <circle cx="100" cy="80" r="48" fill="#EFB287"/>
    <!-- –ø–æ–ª–æ—Å–æ—á–∫–∏ -->
    <path d="M92 34 v10 M100 31 v11 M108 34 v10" stroke="#E09E6C" stroke-width="4.5" stroke-linecap="round"/>
    <!-- –≥–ª–∞–∑–∞ -->
    <g class="blink-eyes">
      <path d="M76 76 q9 -11 18 0" fill="none" stroke="#3A2E28" stroke-width="5" stroke-linecap="round"/>
      <path d="M106 76 q9 -11 18 0" fill="none" stroke="#3A2E28" stroke-width="5" stroke-linecap="round"/>
    </g>
    <!-- –Ω–æ—Å–∏–∫ –∏ —Ä–æ—Ç–∏–∫ -->
    <path d="M95 88 h10 l-5 7 z" fill="#D97B6C" stroke="#D97B6C" stroke-width="3" stroke-linejoin="round"/>
    <path d="M100 96 q-2 7 -10 6 M100 96 q2 7 10 6" fill="none" stroke="#3A2E28" stroke-width="3.5" stroke-linecap="round"/>
    <!-- —Ä—É–º—è–Ω–µ—Ü -->
    <ellipse cx="65" cy="97" rx="9" ry="5.5" fill="#E88D7B" opacity=".5"/>
    <ellipse cx="135" cy="97" rx="9" ry="5.5" fill="#E88D7B" opacity=".5"/>
    <!-- —É—Å—ã -->
    <g stroke="#3A2E28" stroke-width="2.5" stroke-linecap="round" opacity=".4">
      <path d="M36 82 l20 6"/><path d="M34 96 l21 1"/><path d="M37 110 l19 -5"/>
      <path d="M164 82 l-20 6"/><path d="M166 96 l-21 1"/><path d="M163 110 l-19 -5"/>
    </g>
    <!-- –ª–∞–ø–∫–∏ -->
    <ellipse cx="72" cy="170" rx="17" ry="13" fill="#F7D3AE"/>
    <g class="paw-wave">
      <ellipse cx="128" cy="170" rx="17" ry="13" fill="#F7D3AE"/>
      <path d="M122 163 v5 M128 162 v6 M134 163 v5" stroke="#E0A878" stroke-width="3" stroke-linecap="round"/>
    </g>
    <path d="M66 163 v5 M72 162 v6 M78 163 v5" stroke="#E0A878" stroke-width="3" stroke-linecap="round"/>
  </svg>`;
}
$('start-kitten').innerHTML = kittenSVG();
$('hud-kitten').innerHTML = kittenSVG();
$('pop-kitten').innerHTML = kittenSVG();
$('res-kitten').innerHTML = kittenSVG();

/* –≤—Å–ø–ª—ã–≤–∞—à–∫–∞ –∫–æ—Ç–∏–∫–∞ */
let popTimer = null;
function showKitten(text, ms=4600){
  $('pop-text').textContent = text;
  $('kitten-pop').classList.remove('hiddenpop');
  clearTimeout(popTimer);
  popTimer = setTimeout(hideKitten, ms);
}
function hideKitten(){ $('kitten-pop').classList.add('hiddenpop'); }
$('kitten-pop').addEventListener('pointerdown', hideKitten);

/* ============================================================
   –ß–ò–°–õ–û–í–ê–Ø –ü–†–Ø–ú–ê–Ø: –≥–µ–æ–º–µ—Ç—Ä–∏—è
============================================================ */
const X0 = 34, STEP = 23, AXIS_Y = 84;
const xFor = v => X0 + (v + 10) * STEP;
const vFor = x => Math.max(-10, Math.min(30, Math.round((x - X0) / STEP) - 10));

/* —Å—Ç—Ä–æ–∏–º –¥–µ–ª–µ–Ω–∏—è –∏ –ø–æ–¥–ø–∏—Å–∏ */
(function buildTicks(){
  let h = '';
  for(let v=-10; v<=30; v++){
    const x = xFor(v), major = v % 5 === 0;
    const y1 = major ? 71 : 77;
    h += `<line x1="${x}" y1="${y1}" x2="${x}" y2="89" stroke="${major ? '#6F6960' : '#C4BCAF'}" stroke-width="${major ? 3 : 2}" stroke-linecap="round"/>`;
    const col = v===0 ? '#CE7048' : (major ? '#4A443C' : '#8B847A');
    h += `<text x="${x}" y="112" text-anchor="middle" font-size="${major ? 14.5 : 12.5}" font-weight="${major ? 800 : 700}" fill="${col}" font-family="Nunito,sans-serif">${fmt(v)}</text>`;
  }
  $('g-ticks').innerHTML = h;
})();

/* –¥—É–≥–∞-—Å—Ç—Ä–µ–ª–æ—á–∫–∞ */
function arcData(x1, x2){
  const aY = AXIS_Y - 14;
  const dx = x2 - x1;
  const hgt = Math.min(Math.max(Math.abs(dx) * 0.30, 13), 46);
  const mid = (x1 + x2) / 2;
  const d = `M ${x1} ${aY} Q ${mid} ${aY - 2*hgt} ${x2} ${aY}`;
  const ang = Math.atan2(2*hgt, (x2 - mid)) * 180 / Math.PI;
  return { d, mid, apexY: aY - hgt, ang, endX:x2, endY:aY };
}
function arrowMarkup(x1, x2, color, labelText, labelColor, extra=''){
  if (Math.abs(x2 - x1) < 4) return '';
  const A = arcData(x1, x2);
  return `
    <path d="${A.d}" fill="none" stroke="${color}" stroke-width="5" stroke-linecap="round" ${extra}/>
    <polygon points="0,0 -11,-5.5 -11,5.5" fill="${color}" transform="translate(${A.endX},${A.endY}) rotate(${A.ang})" ${extra}/>
    <text x="${A.mid}" y="${A.apexY - 10}" text-anchor="middle" font-size="21" font-weight="900" fill="${labelColor}" stroke="#FFFDF9" stroke-width="6" paint-order="stroke" font-family="Nunito,sans-serif">${labelText}</text>`;
}
function dotMarkup(v, color, ring=false){
  const x = xFor(v);
  return ring
    ? `<circle cx="${x}" cy="${AXIS_Y}" r="9.5" fill="rgba(255,255,255,.9)" stroke="${color}" stroke-width="4.5"/>
       <circle cx="${x}" cy="${AXIS_Y}" r="3.5" fill="${color}"/>`
    : `<circle cx="${x}" cy="${AXIS_Y}" r="8" fill="#fff" stroke="${color}" stroke-width="4.5"/>
       <circle cx="${x}" cy="${AXIS_Y}" r="3" fill="${color}"/>`;
}

/* –æ—Ç—Ä–∏—Å–æ–≤–∫–∞ —Å–ª–æ—è —É—á–µ–Ω–∏–∫–∞ */
function drawUser(){
  const gU = $('g-user'), gM = $('g-markers');
  const faded = S.checked && !S.okNow;
  let u='', m='';
  if (S.startVal !== null){
    let start = dotMarkup(S.startVal, '#CE7048');
    if (faded) start = start.replaceAll('#CE7048"', '#CE7048" opacity=".4"');
    m = start;
    if (S.endVal !== null && S.endVal !== S.startVal){
      const extra = faded ? 'opacity=".3"' : '';
      u = arrowMarkup(xFor(S.startVal), xFor(S.endVal), '#CE7048', fmtD(S.endVal - S.startVal), '#D65A4E', extra);
      m += `<circle cx="${xFor(S.endVal)}" cy="${AXIS_Y}" r="5.5" fill="#CE7048" ${extra}/>`;
    }
  }
  gU.innerHTML = u; gM.innerHTML = m;
}

/* —Å–ª–æ–π –ø—Ä–∞–≤–∏–ª—å–Ω–æ–≥–æ —Ä–µ—à–µ–Ω–∏—è */
function drawCorrect(){
  const t = cur(), r = res(t);
  let h = arrowMarkup(xFor(t[0]), xFor(r), '#6F9B77', fmtD(r - t[0]), '#D65A4E');
  h += dotMarkup(t[0], '#6F9B77', true);
  h += `<circle cx="${xFor(r)}" cy="${AXIS_Y}" r="5.5" fill="#6F9B77"/>`;
  $('g-correct').innerHTML = h;
}

/* ============================================================
   –ë–ï–ô–î–ñ–ò–ö–ò –ü–û–î –ü–†–Ø–ú–û–ô
============================================================ */
function drawChips(){
  let h='';
  if (S.startVal !== null){
    h += `<span class="inline-flex items-center gap-1.5 rounded-full bg-[#F7E3D7] text-[#8A5A3C] px-3.5 py-1.5 text-xs sm:text-sm font-black border border-[#EFD2BE]">–Ω–∞—á–∞–ª–æ ¬∑ ${fmt(S.startVal)}</span>`;
  }
  if (S.endVal !== null){
    h += `<span class="inline-flex items-center gap-1.5 rounded-full bg-[#FBE9E5] text-[#C05B4E] px-3.5 py-1.5 text-xs sm:text-sm font-black border border-[#F4CEC6]">—à–∞–≥ ¬∑ ${fmtD(S.endVal - S.startVal)}</span>`;
    h += `<span class="inline-flex items-center gap-1.5 rounded-full bg-[#F1EDE4] text-[#4A443C] px-3.5 py-1.5 text-xs sm:text-sm font-black border border-[#E5DECE]">–∫–æ–Ω–µ—Ü ¬∑ ${fmt(S.endVal)}</span>`;
  }
  $('chips').innerHTML = h;
}

/* ============================================================
   –®–ê–ì–ò, –ü–û–î–°–ö–ê–ó–ö–ò, –ö–ù–û–ü–ö–ò
============================================================ */
function ansParsed(){
  const v = $('inp-ans').value.trim().replace('‚àí','-');
  return /^-?\d+$/.test(v) ? parseInt(v,10) : null;
}
function ansGiven(){ return ansParsed() !== null; }
function arrowReady(){ return S.startVal!==null && S.endVal!==null && S.endVal!==S.startVal; }

function setStepPills(){
  const p1=$('pill-1'), p2=$('pill-2'), p3=$('pill-3');
  [p1,p2,p3].forEach(p=>p.classList.remove('active','done'));
  const a = ansGiven(), st = S.startVal!==null, ar = arrowReady();
  if (S.checked){ p1.classList.add(S.stats.at(-1).ansOk?'done':'active'); p2.classList.add('done'); p3.classList.add(S.stats.at(-1).lineOk?'done':'active'); return; }
  if (a) p1.classList.add('done'); else p1.classList.add('active');
  if (st) p2.classList.add('done'); else if (a) p2.classList.add('active');
  if (ar) p3.classList.add('done'); else if (st) p3.classList.add('active');
}

const HINTS = {
  answer:'–®–∞–≥ 1. –í–ø–∏—à–∏ –æ—Ç–≤–µ—Ç –≤ –æ–∫–æ—à–∫–æ. –û—Ç—Ä–∏—Ü–∞—Ç–µ–ª—å–Ω–æ–µ —á–∏—Å–ª–æ? –ù–∞–∂–º–∏ –∫–Ω–æ–ø–∫—É ¬± ‚Äî –æ–Ω–∞ —Å—Ç–∞–≤–∏—Ç –º–∏–Ω—É—Å!',
  point :'–®–∞–≥ 2. –ù–∞–∂–º–∏ –Ω–∞ —á–∏—Å–ª–æ–≤—É—é –ø—Ä—è–º—É—é ‚Äî –æ—Ç–º–µ—Ç—å —Ç–æ—á–∫—É, —Å –∫–æ—Ç–æ—Ä–æ–π –Ω–∞—á–∏–Ω–∞–µ–º —Å—á—ë—Ç.',
  draw  :'–®–∞–≥ 3. –ó–∞–∂–º–∏ —Ç–æ—á–∫—É (–∏–ª–∏ –ª—é–±–æ–µ –º–µ—Å—Ç–æ –Ω–∞ –ø—Ä—è–º–æ–π) –∏ –ø–æ—Ç—è–Ω–∏ —Å—Ç—Ä–µ–ª–æ—á–∫—É –Ω–∞ –Ω—É–∂–Ω–æ–µ —á–∏—Å–ª–æ –¥–µ–ª–µ–Ω–∏–π.',
  ready :'–°—É–ø–µ—Ä! –ö—Ä–∞—Å–Ω–∞—è —Ü–∏—Ñ—Ä–∞ –ø–æ–∫–∞–∑—ã–≤–∞–µ—Ç —Ç–≤–æ–π —à–∞–≥. –í—Å—ë –≤–µ—Ä–Ω–æ? –ñ–º–∏ ¬´–ü—Ä–æ–≤–µ—Ä–∏—Ç—å¬ª!',
  doneBad:'–†–∞–∑–±–µ—Ä–∏ –ø—Ä–∞–≤–∏–ª—å–Ω–æ–µ —Ä–µ—à–µ–Ω–∏–µ ‚Äî –∞ –º—ã –¥–≤–∏–≥–∞–µ–º—Å—è –¥–∞–ª—å—à–µ!'
};
function setHint(k, warn=false){
  const h=$('hint'); h.textContent=HINTS[k];
  h.style.color = warn ? '#C05B4E' : '';
}
function updateUI(){
  const wrap=$('line-wrap');
  const locked = !ansGiven() || S.checked;
  wrap.classList.toggle('locked', locked);
  wrap.classList.toggle('unlocked', !locked);
  $('btn-reset').disabled = locked || S.startVal===null || S.dragging;
  const main=$('btn-main');
  if (!S.checked){
    $('btn-main-label').textContent='–ü—Ä–æ–≤–µ—Ä–∏—Ç—å';
    $('btn-main-icon').setAttribute('data-lucide','check-check');
    main.disabled = !arrowReady();
    setHint(!ansGiven() ? 'answer' : S.startVal===null ? 'point' : !arrowReady() ? 'draw' : 'ready');
  } else {
    $('btn-main-label').textContent = S.idx === TASKS.length-1 ? '–†–µ–∑—É–ª—å—Ç–∞—Ç—ã' : '–î–∞–ª—å—à–µ';
    $('btn-main-icon').setAttribute('data-lucide', S.idx === TASKS.length-1 ? 'flag' : 'arrow-right');
    main.disabled = false;
  }
  setStepPills();
  icons();
}

/* ============================================================
   –í–ó–ê–ò–ú–û–î–ï–ô–°–¢–í–ò–ï –° –ü–†–Ø–ú–û–ô
============================================================ */
function svgX(e){
  const r = $('svg-line').getBoundingClientRect();
  return (e.clientX - r.left) / r.width * 1000;
}
function lineDown(e){
  if (!ansGiven() || S.checked){
    if (!S.checked){
      setHint('answer', true);
      $('inp-ans').classList.add('hint-wiggle');
      setTimeout(()=>$('inp-ans').classList.remove('hint-wiggle'), 500);
    }
    return;
  }
  e.preventDefault();
  const v = vFor(svgX(e));
  if (S.startVal === null){ S.startVal = v; S.endVal = v; }
  S.dragging = true;
  hideKitten();
  drawUser(); drawChips(); updateUI();
}
function lineMove(e){
  if (!S.dragging) return;
  e.preventDefault();
  S.endVal = vFor(svgX(e));
  drawUser(); drawChips(); updateUI();
}
function lineUp(){
  if (!S.dragging) return;
  S.dragging = false;
  updateUI();
}
const hitEl = $('svg-line');
hitEl.addEventListener('pointerdown', lineDown);
window.addEventListener('pointermove', lineMove, {passive:false});
window.addEventListener('pointerup', lineUp);
window.addEventListener('pointercancel', lineUp);

/* —Å–±—Ä–æ—Å –ª–∏–Ω–∏–∏ */
$('btn-reset').addEventListener('click', ()=>{
  S.startVal = null; S.endVal = null;
  $('g-user').innerHTML=''; $('g-markers').innerHTML=''; $('g-correct').innerHTML='';
  drawChips(); updateUI();
});

/* –≤–≤–æ–¥ –æ—Ç–≤–µ—Ç–∞ */
$('inp-ans').addEventListener('input', ()=>{
  let v = $('inp-ans').value.replace(/‚àí/g,'-').replace(/[^0-9-]/g,'');
  if (v.indexOf('-') > 0) v = v.replace(/-/g,'');
  if ((v.match(/-/g)||[]).length > 1) v = '-' + v.replace(/-/g,'');
  $('inp-ans').value = v;
  $('inp-ans').classList.toggle('filled', v.length>0);
  $('btn-sign').classList.toggle('minus', v.startsWith('-'));
  updateUI();
});

/* –∫–Ω–æ–ø–∫–∞ ¬± ‚Äî —Å—Ç–∞–≤–∏—Ç/—É–±–∏—Ä–∞–µ—Ç –º–∏–Ω—É—Å (—É–¥–æ–±–Ω–æ —Å —Ç–µ–ª–µ—Ñ–æ–Ω–∞) */
$('btn-sign').addEventListener('pointerdown', e=>e.preventDefault());
$('btn-sign').addEventListener('click', ()=>{
  if (S.checked) return;
  const inp=$('inp-ans');
  let v=inp.value.replace(/‚àí/g,'-');
  v = v.startsWith('-') ? v.slice(1) : '-' + v;
  inp.value=v;
  inp.classList.toggle('filled', v.length>0);
  $('btn-sign').classList.toggle('minus', v.startsWith('-'));
  updateUI();
  inp.focus({preventScroll:true});
});
$('inp-ans').addEventListener('keydown', e=>{
  if (e.key === 'Enter'){ e.preventDefault(); if (!$('btn-main').disabled) $('btn-main').click(); }
});
$('inp-ans').addEventListener('focus', hideKitten);

/* ============================================================
   –ü–†–û–í–ï–†–ö–ê
============================================================ */
function wordDivision(n){
  const a = Math.abs(n) % 10, b = Math.abs(n) % 100;
  if (a===1 && b!==11) return '–¥–µ–ª–µ–Ω–∏–µ';
  if (a>=2 && a<=4 && (b<10 || b>=20)) return '–¥–µ–ª–µ–Ω–∏—è';
  return '–¥–µ–ª–µ–Ω–∏–π';
}
function explainText(t){
  const r = res(t);
  const dir  = t[1]==='+' ? '–≤–ø—Ä–∞–≤–æ' : '–≤–ª–µ–≤–æ';
  const verb = t[1]==='+' ? '–ü—Ä–∏–±–∞–≤–ª—è–µ–º' : '–í—ã—á–∏—Ç–∞–µ–º';
  return `–ù–∞—á–∏–Ω–∞–µ–º –≤ —Ç–æ—á–∫–µ ${fmt(t[0])}. ${verb} ${t[2]} ‚Äî –∏–¥—ë–º ${dir} –Ω–∞ ${t[2]} ${wordDivision(t[2])}. –û—Ç–≤–µ—Ç: ${fmt(r)}.`;
}
function burst(x, y){
  const colors=['#CE7048','#6F9B77','#F2C94C','#E5A87E','#8FB7A5','#D97B6C'];
  for(let i=0;i<14;i++){
    const d=document.createElement('span');
    d.className='burst-dot';
    d.style.left=x+'px'; d.style.top=y+'px';
    d.style.background=colors[i%colors.length];
    const ang=Math.random()*Math.PI*2, dist=50+Math.random()*70;
    d.style.setProperty('--dx', Math.cos(ang)*dist+'px');
    d.style.setProperty('--dy', (Math.sin(ang)*dist-40)+'px');
    document.body.appendChild(d);
    setTimeout(()=>d.remove(), 900);
  }
}

function showBanner(ok){
  const b=$('banner'), t=cur(), r=res(t);
  b.classList.remove('hidden');
  if (ok){
    b.style.background='#E7F0E7'; b.style.border='2px solid #CBDFCB';
    $('banner-icon').style.background='#6F9B77';
    $('banner-icon').innerHTML='<i data-lucide="party-popper" class="w-5 h-5 text-white"></i>';
    $('banner-text').style.color='#3E5A44';
    $('banner-text').textContent='–í–µ—Ä–Ω–æ! –ë–∞–ª–ª —Ç–≤–æ–π ‚Äî —Ç–∞–∫ –¥–µ—Ä–∂–∞—Ç—å!';
    $('banner-explain').style.color='#3E5A44';
    $('banner-explain').textContent=explainText(t);
  } else {
    b.style.background='#FBE9E5'; b.style.border='2px solid #F4CEC6';
    $('banner-icon').style.background='#D65A4E';
    $('banner-icon').innerHTML='<i data-lucide="lightbulb" class="w-5 h-5 text-white"></i>';
    $('banner-text').style.color='#8A3A30';
    $('banner-text').textContent='–û—à–∏–±–æ—á–∫–∞! –°–º–æ—Ç—Ä–∏, –∫–∞–∫ –ø—Ä–∞–≤–∏–ª—å–Ω–æ:';
    $('banner-explain').style.color='#8A3A30';
    $('banner-explain').textContent=explainText(t);
  }
  icons();
}

function check(){
  const t=cur(), r=res(t);
  const ua = ansParsed();
  const ansOk  = ua === r;
  const lineOk = S.startVal === t[0] && S.endVal === r;
  const ok = ansOk && lineOk;

  S.checked = true; S.okNow = ok;
  S.stats.push({a:t[0], op:t[1], b:t[2], res:r,
    userAns: ua===null ? '‚Äî' : ua, ansOk, lineOk, ok});

  /* –æ–∫–æ—à–∫–æ –æ—Ç–≤–µ—Ç–∞ ‚Üí —Å—Ç–∞—Ç–∏—á–Ω–æ–µ */
  const inp=$('inp-ans'), st=$('ans-static');
  $('btn-sign').classList.add('hidden');
  if (ok || ansOk){
    inp.classList.add('hidden'); st.classList.remove('hidden'); st.classList.add('inline-flex');
    st.innerHTML=`<span class="px-2 text-[#58805F]">${fmt(r)}</span><span class="w-8 h-8 rounded-xl bg-[#E7F0E7] flex items-center justify-center"><i data-lucide="check" class="w-5 h-5 text-[#58805F]"></i></span>`;
  } else {
    inp.classList.add('hidden'); st.classList.remove('hidden'); st.classList.add('inline-flex');
    st.innerHTML=`<span class="px-1 text-[#C05B4E] line-through decoration-[3px] opacity-70">${ua===null?'?':fmt(ua)}</span><span class="px-2 text-[#58805F]">${fmt(r)}</span><span class="w-8 h-8 rounded-xl bg-[#E7F0E7] flex items-center justify-center"><i data-lucide="check" class="w-5 h-5 text-[#58805F]"></i></span>`;
  }

  drawUser();
  if (!ok){
    drawCorrect();
    showKitten('–ù–µ –ø–µ—Ä–µ–∂–∏–≤–∞–π! –†–∞–∑–±–µ—Ä–∏ —Ä–µ—à–µ–Ω–∏–µ ‚Äî —É —Ç–µ–±—è –≤—Å—ë –ø–æ–ª—É—á–∏—Ç—Å—è!', 5200);
  } else {
    S.score++;
    $('score-num').textContent = S.score;
    $('hud-score').classList.remove('score-pulse'); void $('hud-score').offsetWidth;
    $('hud-score').classList.add('score-pulse');
    const br=$('btn-main').getBoundingClientRect();
    burst(br.left+br.width/2, br.top);
  }
  showBanner(ok);
  updateUI();
}

/* ============================================================
   –ü–ï–†–ï–•–û–î–´ –ó–ê–î–ê–ù–ò–ô
============================================================ */
function renderTask(){
  const t=cur();
  S.startVal=null; S.endVal=null; S.dragging=false; S.checked=false; S.okNow=false;
  $('g-user').innerHTML=''; $('g-markers').innerHTML=''; $('g-correct').innerHTML='';
  $('eq-a').textContent = fmt(t[0]);
  $('eq-op').textContent = t[1]==='+' ? '+' : '‚àí';
  $('eq-b').textContent = t[2];
  const inp=$('inp-ans'), st=$('ans-static');
  $('btn-sign').classList.remove('hidden','minus');
  inp.value=''; inp.classList.remove('hidden','filled');
  st.classList.add('hidden'); st.classList.remove('inline-flex');
  $('banner').classList.add('hidden');
  $('hud-task').textContent = `–ü—Ä–∏–º–µ—Ä ${S.idx+1} –∏–∑ ${TASKS.length}`;
  $('bar-fill').style.width = (S.idx)/TASKS.length*100 + '%';
  drawChips();
  $('task-card').classList.remove('card-pop'); void $('task-card').offsetWidth;
  $('task-card').classList.add('card-pop');
  updateUI();
  setTimeout(()=>inp.focus({preventScroll:true}), 350);

  /* –∫–æ—Ç–∏–∫-–ø–æ–¥–±–∞–¥—Ä–∏–≤–∞—Ç–µ–ª—å: –ø–µ—Ä–µ–¥ –ø–µ—Ä–≤—ã–º –∏ –¥–∞–ª–µ–µ —á–µ—Ä–µ–∑ –∫–∞–∂–¥—É—é –ø–∞—Ä—É –ø—Ä–∏–º–µ—Ä–æ–≤ */
  const n = S.idx + 1;
  if (n === 1){
    setTimeout(()=>showKitten(`–ü—Ä–∏–≤–µ—Ç, ${S.name}! –Ø –ú—É—Ä—á–∏–∫. –†–µ—à–∞–π –ø—Ä–∏–º–µ—Ä—ã, –∞ —è –±—É–¥—É –ø–æ–¥–±–∞–¥—Ä–∏–≤–∞—Ç—å!`, 6000), 700);
  } else if (n === 15){
    setTimeout(()=>showKitten('–ü–æ–ª–æ–≤–∏–Ω–∞ –ø—É—Ç–∏ –ø—Ä–æ–π–¥–µ–Ω–∞! –¢—ã –±–æ–ª—å—à–æ–π –º–æ–ª–æ–¥–µ—Ü!', 5000), 650);
  } else if (n === 29){
    setTimeout(()=>showKitten('–û—Å—Ç–∞–ª–æ—Å—å –≤—Å–µ–≥–æ –¥–≤–∞ –ø—Ä–∏–º–µ—Ä–∞! –§–∏–Ω–∏—à —É–∂–µ –±–ª–∏–∑–∫–æ!', 5000), 650);
  } else if (n % 2 === 1){
    setTimeout(()=>showKitten(PHRASES[Math.floor(n/2) % PHRASES.length], 4600), 650);
  }
}

$('btn-main').addEventListener('click', ()=>{
  if (!S.checked){ check(); return; }
  if (S.idx >= TASKS.length-1){ showResults(); return; }
  S.idx++;
  hideKitten();
  renderTask();
});

/* ============================================================
   –†–ï–ó–£–õ–¨–¢–ê–¢–´
============================================================ */
function showResults(){
  hideKitten();
  $('scr-game').classList.add('hidden');
  $('scr-results').classList.remove('hidden');
  window.scrollTo({top:0, behavior:'smooth'});
  $('bar-fill').style.width='100%';

  const okCount = S.stats.filter(s=>s.ok).length;
  const pct = Math.round(okCount / TASKS.length * 100);
  $('res-name').textContent = `${S.name} ${S.surname}`;
  $('res-date').textContent = new Date().toLocaleDateString('ru-RU',{day:'numeric',month:'long',year:'numeric'});
  $('res-score').textContent = okCount;
  $('res-ok').textContent = okCount;
  $('res-bad').textContent = TASKS.length - okCount;
  $('res-pct').textContent = pct + '%';
  $('res-ring-arc').setAttribute('stroke-dasharray', `${(pct/100*327).toFixed(1)} 327`);

  let title, verdict;
  if (pct>=90){ title='–ü–æ—Ç—Ä—è—Å–∞—é—â–µ!'; verdict='–ú—É—Ä—á–∏–∫ –≤ –≤–æ—Å—Ç–æ—Ä–≥–µ! –¢—ã –Ω–∞—Å—Ç–æ—è—â–∏–π —á–µ–º–ø–∏–æ–Ω —á–∏—Å–ª–æ–≤–æ–π –ø—Ä—è–º–æ–π!'; }
  else if (pct>=70){ title='–û—Ç–ª–∏—á–Ω–∞—è —Ä–∞–±–æ—Ç–∞!'; verdict='–û—á–µ–Ω—å –¥–æ—Å—Ç–æ–π–Ω—ã–π —Ä–µ–∑—É–ª—å—Ç–∞—Ç! –ï—â—ë —á—É—Ç—å-—á—É—Ç—å ‚Äî –∏ –±—É–¥–µ—Ç –∏–¥–µ–∞–ª—å–Ω–æ.'; }
  else if (pct>=50){ title='–•–æ—Ä–æ—à–æ –ø–æ–ª—É—á–∏–ª–æ—Å—å!'; verdict='–ü–æ–ª–æ–≤–∏–Ω–∞ —É—Å–ø–µ—Ö–∞ —É–∂–µ –µ—Å—Ç—å! –ü–æ—Ç—Ä–µ–Ω–∏—Ä—É–π—Å—è –µ—â—ë ‚Äî –≤—Å—ë –æ–±—è–∑–∞—Ç–µ–ª—å–Ω–æ –ø–æ–ª—É—á–∏—Ç—Å—è.'; }
  else { title='–ì–ª–∞–≤–Ω–æ–µ ‚Äî –Ω–µ —Å–¥–∞–≤–∞—Ç—å—Å—è!'; verdict='–ü–æ–≤—Ç–æ—Ä–∏ —Ç–µ–º—É –∏ –ø–æ–ø—Ä–æ–±—É–π –µ—â—ë —Ä–∞–∑. –ú—É—Ä—á–∏–∫ –≤–µ—Ä–∏—Ç –≤ —Ç–µ–±—è!'; }
  $('res-title').textContent = title;
  $('res-verdict').textContent = verdict;

  /* —Ç–∞–±–ª–∏—Ü–∞ */
  let rows='';
  S.stats.forEach((s,i)=>{
    const expr = `${fmt(s.a)} ${s.op==='+'?'+':'‚àí'} ${s.b}`;
    const badge = s.ok
      ? '<span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-[#E7F0E7]"><i data-lucide="check" class="w-4 h-4 text-[#58805F]"></i></span>'
      : '<span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-[#FBE9E5]"><i data-lucide="x" class="w-4 h-4 text-[#C05B4E]"></i></span>';
    const uaCls = s.ansOk ? 'text-[#332E29]' : 'text-[#C05B4E] line-through decoration-2';
    rows += `<tr class="rowline ${i%2? 'bg-[#FFFDF9]':'bg-white'}">
      <td class="py-2.5 pl-4 sm:pl-5 pr-2 font-black text-[#B9B0A2]">${i+1}</td>
      <td class="py-2.5 px-2 font-black">${expr}</td>
      <td class="py-2.5 px-2 font-black ${uaCls}">${typeof s.userAns==='number'?fmt(s.userAns):s.userAns}</td>
      <td class="py-2.5 px-2 font-black text-[#58805F]">${fmt(s.res)}</td>
      <td class="py-2.5 pl-2 pr-4 sm:pr-5 text-right">${badge}</td>
    </tr>`;
  });
  $('res-tbody').innerHTML = rows;
  icons();

  if (pct >= 70){
    setTimeout(()=>{ const r=$('res-kitten').getBoundingClientRect(); burst(r.left+50, r.top+50); }, 500);
    setTimeout(()=>{ const r=$('res-pct').getBoundingClientRect(); burst(r.left+20, r.top+20); }, 900);
  }
}

/* –≤—Å–ø–ª—ã–≤–∞—é—â–∞—è –ø–æ–¥—Å–∫–∞–∑–∫–∞ */
let toastTimer=null;
function toast(msg){
  const prev=document.getElementById('app-toast'); if(prev) prev.remove();
  const t=document.createElement('div');
  t.id='app-toast';
  t.textContent=msg;
  t.style.cssText='position:fixed;left:50%;bottom:22px;transform:translateX(-50%);z-index:95;background:#332E29;color:#fff;font-family:Nunito,sans-serif;font-weight:800;font-size:14px;line-height:1.4;border-radius:18px;padding:12px 20px;box-shadow:0 14px 30px -10px rgba(51,46,41,.55);max-width:min(92vw,430px);text-align:center;opacity:0;transition:opacity .35s';
  document.body.appendChild(t);
  requestAnimationFrame(()=>{ t.style.opacity='1'; });
  clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>{ t.style.opacity='0'; setTimeout(()=>t.remove(),400); }, 4800);
}

/* —Å–æ—Ö—Ä–∞–Ω–µ–Ω–∏–µ —Å—Ç–∞—Ç–∏—Å—Ç–∏–∫–∏ –∫–∞—Ä—Ç–∏–Ω–∫–æ–π –≤ —Ñ–æ—Ä–º–∞—Ç–µ JPEG */
const isMobileUA = /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent);
$('btn-save').addEventListener('click', ()=>{
  if (!window.html2canvas){
    alert('–ù–µ –ø–æ–ª—É—á–∏–ª–æ—Å—å —Å–æ–∑–¥–∞—Ç—å –∫–∞—Ä—Ç–∏–Ω–∫—É (–Ω–µ—Ç –∏–Ω—Ç–µ—Ä–Ω–µ—Ç–∞). –°–¥–µ–ª–∞–π —Å–∫—Ä–∏–Ω—à–æ—Ç —ç–∫—Ä–∞–Ω–∞!');
    return;
  }
  const btn=$('btn-save');
  const oldHtml=btn.innerHTML;
  btn.disabled=true;
  btn.innerHTML='<i data-lucide="loader-circle" class="w-5 h-5 animate-spin"></i> –†–∏—Å—É—é –∫–∞—Ä—Ç–∏–Ω–∫—É‚Ä¶';
  icons();
  hideKitten();

  const fname = `—á–∏—Å–ª–æ–≤–∞—è_–ø—Ä—è–º–∞—è_${(`${S.surname}_${S.name}`).trim().replace(/\s+/g,'_') || '—Ä–µ–∑—É–ª—å—Ç–∞—Ç—ã'}.jpg`;

  html2canvas($('result-shot'), {backgroundColor:'#FAF6EF', scale:2, useCORS:true, logging:false})
    .then(canvas => new Promise((ok,bad)=>canvas.toBlob(b=>b?ok(b):bad(new Error('blob')),'image/jpeg',0.92)))
    .then(async blob=>{
      const file=new File([blob],fname,{type:'image/jpeg'});
      /* –Ω–∞ —Ç–µ–ª–µ—Ñ–æ–Ω–µ: —Å–∏—Å—Ç–µ–º–Ω–æ–µ ¬´–ü–æ–¥–µ–ª–∏—Ç—å—Å—è¬ª ‚Üí ¬´–°–æ—Ö—Ä–∞–Ω–∏—Ç—å –∏–∑–æ–±—Ä–∞–∂–µ–Ω–∏–µ¬ª ‚Üí –ø—Ä—è–º–æ –≤ –≥–∞–ª–µ—Ä–µ—é */
      if (isMobileUA && navigator.canShare && navigator.canShare({files:[file]})){
        try{
          await navigator.share({files:[file]});
          toast('–í—ã–±–µ—Ä–∏ ¬´–°–æ—Ö—Ä–∞–Ω–∏—Ç—å –∏–∑–æ–±—Ä–∞–∂–µ–Ω–∏–µ¬ª ‚Äî –∫–∞—Ä—Ç–∏–Ω–∫–∞ –ø–æ–ø–∞–¥—ë—Ç –≤ –≥–∞–ª–µ—Ä–µ—é!');
          return;
        }catch(e){
          if (e && e.name==='AbortError') return;
        }
      }
      /* –æ–±—ã—á–Ω–æ–µ —Å–∫–∞—á–∏–≤–∞–Ω–∏–µ (–∫–æ–º–ø—å—é—Ç–µ—Ä / –µ—Å–ª–∏ –ø–æ–¥–µ–ª–∏—Ç—å—Å—è –Ω–µ–¥–æ—Å—Ç—É–ø–Ω–æ) */
      const url=URL.createObjectURL(blob);
      const a=document.createElement('a');
      a.href=url; a.download=fname;
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(()=>URL.revokeObjectURL(url),6000);
      toast(isMobileUA
        ? '–ö–∞—Ä—Ç–∏–Ω–∫–∞ JPEG —Å–æ—Ö—Ä–∞–Ω–µ–Ω–∞! –ò—â–∏ –µ—ë –≤ –≥–∞–ª–µ—Ä–µ–µ –∏–ª–∏ –≤ –∑–∞–≥—Ä—É–∑–∫–∞—Ö ‚Äî –∏ –æ—Ç–ø—Ä–∞–≤–ª—è–π —É—á–∏—Ç–µ–ª—é.'
        : '–ö–∞—Ä—Ç–∏–Ω–∫–∞ JPEG —Å–∫–∞—á–∞–Ω–∞! –û—Ç–ø—Ä–∞–≤—å –µ—ë —É—á–∏—Ç–µ–ª—é.');
    })
    .catch(()=>alert('–ù–µ –ø–æ–ª—É—á–∏–ª–æ—Å—å —Å–æ–∑–¥–∞—Ç—å –∫–∞—Ä—Ç–∏–Ω–∫—É. –°–¥–µ–ª–∞–π —Å–∫—Ä–∏–Ω—à–æ—Ç —ç–∫—Ä–∞–Ω–∞!'))
    .finally(()=>{ btn.innerHTML=oldHtml; btn.disabled=false; icons(); });
});

/* –∑–∞–Ω–æ–≤–æ */
$('btn-again').addEventListener('click', ()=>{
  S.idx=0; S.score=0; S.stats=[];
  $('score-num').textContent='0';
  $('scr-results').classList.add('hidden');
  $('scr-start').classList.remove('hidden');
  window.scrollTo({top:0, behavior:'smooth'});
  checkNames();
  icons();
});

/* ============================================================
   –°–¢–ê–†–¢ –ò–ì–†–´
============================================================ */
function checkNames(){
  const ok = $('inp-name').value.trim().length>0 && $('inp-surname').value.trim().length>0;
  $('btn-start').disabled = !ok;
}
$('inp-name').addEventListener('input', checkNames);
$('inp-surname').addEventListener('input', checkNames);
[$('inp-name'),$('inp-surname')].forEach(el=>el.addEventListener('keydown',e=>{
  if(e.key==='Enter' && !$('btn-start').disabled) $('btn-start').click();
}));

$('btn-start').addEventListener('click', ()=>{
  S.name = $('inp-name').value.trim();
  S.surname = $('inp-surname').value.trim();
  $('scr-start').classList.add('hidden');
  $('scr-game').classList.remove('hidden');
  window.scrollTo({top:0, behavior:'smooth'});
  renderTask();
  icons();
});

icons();
</script>


