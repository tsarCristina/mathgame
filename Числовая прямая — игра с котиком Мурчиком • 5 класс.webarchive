      <!-- —Ñ–æ—Ä–º–∞ -->
      <div class="card-pop bg-white rounded-[28px] border border-[#EAE2D4] shadow-[0_18px_40px_-24px_rgba(51,46,41,.25)] p-6 sm:p-8 flex flex-col">
